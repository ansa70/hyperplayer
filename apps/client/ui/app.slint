import { CheckBox, ComboBox, LineEdit, ListView, Slider, ScrollView } from "std-widgets.slint";

/// One rule of a smart playlist, as its editor shows it.
export struct RuleRow {
    /// Index into the editor's field list.
    field: int,
    /// The operators this field takes, as labels, and the chosen one.
    ops: [string],
    op: int,
    value: string,
    value2: string,
    /// What to type: "seconds or m:ss", "days", "yes or no"…
    hint: string,
    needs-value: bool,
    between: bool,
}

/// Something the playlist page's search can add: a track, album, artist or genre.
export struct AddItem {
    id: string,
    title: string,
    detail: string,
}

export struct ArtistItem {
    id: string,
    name: string,
    subtitle: string,
    image: image,
}

export struct AlbumItem {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
}

/// One row of the Albums grid.
export struct AlbumRow {
    items: [AlbumItem],
}

export struct TrackItem {
    number: string,
    title: string,
    artist: string,
    duration: string,
    playing: bool,
    /// False for playlist entries whose file is currently missing.
    available: bool,
}

export struct PlaylistItem {
    id: string,
    name: string,
    subtitle: string,
    smart: bool,
}

export struct PlaylistView {
    id: string,
    name: string,
    meta: string,
    cover: image,
}

export struct ArtistView {
    id: string,
    name: string,
    stats: string,
    genres: string,
    meta: string,
    biography: string,
    image: image,
}

/// A row in a credits or band-member list. `heading` is set on the first row of each group.
export struct CreditItem {
    heading: string,
    name: string,
    detail: string,
    artist-id: string,
}

export struct AlbumView {
    id: string,
    title: string,
    artist: string,
    meta: string,
    genres: string,
    cover: image,
}

export struct NowPlayingView {
    active: bool,
    track-id: string,
    title: string,
    artist: string,
    album: string,
    year: string,
    format: string,
    quality: string,
    genres: string,
    artist-id: string,
    artist-meta: string,
    biography: string,
    /// Shown while credits / artist details are still being fetched.
    loading-details: bool,
    cover: image,
    backdrop: image,
    accent: color,
}

export struct LoginState {
    /// The built-in admin still has its default password: hint at it on the sign-in form.
    default-admin: bool,
    /// Signed in with a default password: a new one must be chosen before anything else.
    changing-password: bool,
    /// The current password isn't known (e.g. the app restarted mid-change), so ask for it.
    need-current: bool,
    /// First run, admin password set: register the person who'll actually listen.
    onboarding: bool,
    busy: bool,
    error: string,
    /// A server with a certificate this computer doesn't trust: ask whether to (its SHA-256).
    trust-fingerprint: string,
    trust-server: string,
}

export enum Page { welcome, artist, album, search, playlist, queue, lyrics, history, albums, settings }
export enum LyricsState { loading, none, instrumental, plain, synced }

export enum RepeatMode { off, all, one }

