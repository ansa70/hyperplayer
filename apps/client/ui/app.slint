import { LineEdit, ListView, Slider, ScrollView } from "std-widgets.slint";

export struct ArtistItem {
    id: string,
    name: string,
    subtitle: string,
    image: image,
}

export struct AlbumItem {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
}

/// One row of the Albums grid.
export struct AlbumRow {
    items: [AlbumItem],
}

export struct TrackItem {
    number: string,
    title: string,
    artist: string,
    duration: string,
    playing: bool,
    /// False for playlist entries whose file is currently missing.
    available: bool,
}

export struct PlaylistItem {
    id: string,
    name: string,
    subtitle: string,
}

export struct PlaylistView {
    id: string,
    name: string,
    meta: string,
    cover: image,
}

export struct ArtistView {
    id: string,
    name: string,
    stats: string,
    genres: string,
    meta: string,
    biography: string,
    image: image,
}

/// A row in a credits or band-member list. `heading` is set on the first row of each group.
export struct CreditItem {
    heading: string,
    name: string,
    detail: string,
    artist-id: string,
}

export struct AlbumView {
    id: string,
    title: string,
    artist: string,
    meta: string,
    genres: string,
    cover: image,
}

export struct NowPlayingView {
    active: bool,
    track-id: string,
    title: string,
    artist: string,
    album: string,
    year: string,
    format: string,
    quality: string,
    genres: string,
    artist-id: string,
    artist-meta: string,
    biography: string,
    /// Shown while credits / artist details are still being fetched.
    loading-details: bool,
    cover: image,
    backdrop: image,
    accent: color,
}

export struct LoginState {
    /// The built-in admin still has its default password: hint at it on the sign-in form.
    default-admin: bool,
    /// Signed in with a default password: a new one must be chosen before anything else.
    changing-password: bool,
    /// The current password isn't known (e.g. the app restarted mid-change), so ask for it.
    need-current: bool,
    /// First run, admin password set: register the person who'll actually listen.
    onboarding: bool,
    busy: bool,
    error: string,
}

export enum Page { welcome, artist, album, search, playlist, queue, lyrics, history, albums, settings }
export enum LyricsState { loading, none, instrumental, plain, synced }

export enum RepeatMode { off, all, one }

// Icon outlines from Lucide (https://lucide.dev, ISC licence), 24×24 viewbox.
global Icons {
    out property <string> shuffle: "M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22 M18 2l4 4-4 4 M2 6h1.9c1.5 0 2.9.9 3.6 2.2 M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8 M18 14l4 4-4 4";
    out property <string> repeat: "M17 2l4 4-4 4 M3 11v-1a4 4 0 0 1 4-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 0 1-4 4H3";
    out property <string> repeat-one: "M17 2l4 4-4 4 M3 11v-1a4 4 0 0 1 4-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 0 1-4 4H3 M11 10h1v4";
    out property <string> queue: "M16 5H3 M16 12H3 M11 19H3 M21 16v6 M18 19h6";
    // Lucide "disc-3".
    out property <string> albums: "M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0 M6 12c0-1.7.7-3.2 1.8-4.2 M10 12a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M18 12c0 1.7-.7 3.2-1.8 4.2";
    // Lucide "history".
    out property <string> history: "M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5 M12 7v5l4 2";
    // Lucide "mic-vocal".
    out property <string> lyrics: "M11 7.601l-5.994 8.19a1 1 0 0 0 .1 1.298l.817.818a1 1 0 0 0 1.314.087L15.09 12 M16.5 21.174C15.5 20.5 14.372 20 13 20c-2.058 0-3.928 2.356-6 2-2.072-.356-2.775-3.369-1.5-4.5 M11 7a5 5 0 1 0 10 0a5 5 0 1 0-10 0";
    out property <string> more: "M12 12h.01 M19 12h.01 M5 12h.01";
    out property <string> plus: "M5 12h14 M12 5v14";
}

global Theme {
    out property <color> bg: #0c0d10;
    out property <color> surface: #15171c;
    out property <color> surface-hi: #1e2128;
    out property <color> text: #f2f3f5;
    out property <color> muted: #9097a3;
    out property <color> faint: #5c6370;
    out property <length> radius: 10px;
}

component Cover inherits Rectangle {
    in property <image> source;
    in property <length> size: 160px;
    width: size;
    height: size;
    border-radius: Theme.radius;
    background: Theme.surface-hi;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: 36px;
    in property <bool> primary;
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    background: primary ? (ta.has-hover ? #ffffff : #e8e9ec) : (ta.has-hover ? Theme.surface-hi : transparent);
    animate background { duration: 120ms; }
    Text {
        text: glyph;
        color: primary ? Theme.bg : Theme.text;
        font-size: size * 0.42;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

/// Toggle with a vector icon; an accent dot underneath marks it active.
component ToggleIcon inherits Rectangle {
    in property <string> commands;
    in property <bool> active;
    in property <color> accent: #1ed760;
    in property <string> tooltip;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: ta.has-hover ? Theme.surface-hi : transparent;
    animate background { duration: 120ms; }
    Path {
        x: 9px;
        y: 8px;
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: root.active ? root.accent : (ta.has-hover ? Theme.text : Theme.muted);
        stroke-width: 1.6px;
    }
    if root.active: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 5px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> accent: Theme.muted;
    height: 22px;
    width: label.preferred-width + 16px;
    border-radius: 11px;
    border-width: 1px;
    border-color: accent.with-alpha(0.5);
    background: accent.with-alpha(0.12);
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CreditList inherits VerticalLayout {
    in property <[CreditItem]> items;
    in property <color> accent: Theme.muted;
    callback select-artist(string);
    spacing: 2px;
    for item in root.items: VerticalLayout {
        padding-top: item.heading != "" ? 12px : 0px;
        spacing: 4px;
        if item.heading != "": Text {
            text: item.heading;
            color: Theme.faint;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: item.name;
                color: item.artist-id != "" && ta.has-hover ? root.accent.brighter(0.4) : Theme.text;
                font-size: 12px;
                font-weight: 600;
                min-width: 110px;
                max-width: 150px;
                overflow: elide;
                ta := TouchArea {
                    enabled: item.artist-id != "";
                    mouse-cursor: item.artist-id != "" ? pointer : default;
                    clicked => { root.select-artist(item.artist-id); }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: item.detail;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 30px;
    border-radius: 4px;
    background: ta.has-hover ? Theme.surface.brighter(0.6) : transparent;
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

/// Actions on a track (or a whole album): queue it, add it to a playlist, and,
/// where the list allows, remove or move it.
component ActionMenu inherits PopupWindow {
    in property <[PlaylistItem]> playlists;
    in property <bool> removable;
    in property <bool> movable;
    in property <string> remove-label: "Remove";
    callback action(string, string);
    width: 230px;
    Rectangle {
        background: Theme.surface-hi;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.surface.brighter(0.8);
        drop-shadow-blur: 18px;
        drop-shadow-color: #000000b0;
        VerticalLayout {
            padding: 6px;
            spacing: 1px;
            MenuItem { text: "Play next"; clicked => { root.action("next", ""); } }
            MenuItem { text: "Add to queue"; clicked => { root.action("end", ""); } }
            if root.movable: MenuItem { text: "Move up"; clicked => { root.action("up", ""); } }
            if root.movable: MenuItem { text: "Move down"; clicked => { root.action("down", ""); } }
            if root.removable: MenuItem { text: root.remove-label; clicked => { root.action("remove", ""); } }
            Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.surface.brighter(0.8); } }
            Text {
                text: "ADD TO PLAYLIST";
                color: Theme.faint;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                height: 22px;
                vertical-alignment: center;
            }
            for p in root.playlists: MenuItem { text: p.name; clicked => { root.action("playlist", p.id); } }
            MenuItem { text: "New playlist…"; clicked => { root.action("new-playlist", ""); } }
        }
    }
}

/// One track row; shared by album, search, playlist and queue lists.
component TrackRow inherits Rectangle {
    in property <TrackItem> track;
    in property <[PlaylistItem]> playlists;
    in property <bool> removable;
    in property <bool> movable;
    in property <string> remove-label: "Remove";
    callback play();
    callback action(string, string);
    height: 44px;
    border-radius: 6px;
    background: ta.has-hover || more-ta.has-hover ? Theme.surface-hi : transparent;
    ta := TouchArea { clicked => { if root.track.available { root.play(); } } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 16px;
        Text {
            width: 28px;
            text: track.playing ? "♪" : track.number;
            color: track.playing ? #1ed760 : Theme.faint;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: track.title;
                color: !track.available ? Theme.faint : track.playing ? #1ed760 : Theme.text;
                font-size: 14px;
                overflow: elide;
            }
            Text { text: track.available ? track.artist : track.artist + " · missing"; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
        Text { text: track.duration; color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
        Rectangle {
            width: 32px;
            Path {
                width: 18px;
                height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.more;
                fill: transparent;
                stroke: more-ta.has-hover ? Theme.text : (ta.has-hover ? Theme.muted : Theme.faint.with-alpha(0.5));
                stroke-width: 2.5px;
                stroke-line-cap: round;
            }
            more-ta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
        }
    }
    menu := ActionMenu {
        x: root.width - self.width - 8px;
        y: root.height - 4px;
        playlists: root.playlists;
        removable: root.removable;
        movable: root.movable;
        remove-label: root.remove-label;
        action(kind, id) => { root.action(kind, id); }
    }
}

/// A sidebar entry leading to a page (Albums, History).
component NavRow inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 30px;
    border-radius: 6px;
    background: root.active ? Theme.surface-hi : (ta.has-hover ? Theme.surface-hi.with-alpha(0.5) : transparent);
    HorizontalLayout {
        padding-left: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                fill: transparent;
                stroke: Theme.muted;
                stroke-width: 2px;
            }
        }
        Text { text: root.text; color: Theme.text; font-size: 13px; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Sidebar inherits Rectangle {
    in property <[ArtistItem]> artists;
    in property <bool> history-open;
    callback show-history();
    in property <bool> albums-open;
    callback show-albums();
    in property <bool> settings-open;
    callback show-settings();
    in property <string> selected-id;
    in property <string> status;
    in property <[PlaylistItem]> playlists;
    in property <string> selected-playlist-id;
    callback select(string);
    callback search-changed(string);
    callback select-playlist(string);
    callback new-playlist();
    in property <string> account;
    callback sign-out();
    callback search-accepted(string);
    public function focus-search() { search.focus(); }
    /// Scrolls the artist list so row `index` is in view (centred if it was off-screen).
    public function reveal-artist(index: int) {
        let row = 52px;
        let top = index * row;
        if top < -artist-list.content-y || top + row > -artist-list.content-y + artist-list.visible-height {
            artist-list.content-y = min(0px, max(artist-list.visible-height - artist-list.content-height, artist-list.visible-height / 2 - top - row / 2));
        }
    }
    /// Empties the search box (and its results); returns whether there was anything to clear.
    public function clear-search() -> bool {
        if search.text == "" { return false; }
        search.text = "";
        root.search-changed("");
        return true;
    }
    background: Theme.surface;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: "HyperPlayer";
            color: Theme.text;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }
        search := LineEdit {
            placeholder-text: "Search artists, albums, tracks   ( / )";
            edited(text) => { root.search-changed(text); }
            accepted(text) => { root.search-accepted(text); }
        }
        NavRow {
            icon: Icons.albums;
            text: "Albums";
            active: root.albums-open;
            clicked => { root.show-albums(); }
        }
        NavRow {
            icon: Icons.history;
            text: "History";
            active: root.history-open;
            clicked => { root.show-history(); }
        }
        HorizontalLayout {
            Text { text: "PLAYLISTS"; color: Theme.faint; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; vertical-alignment: center; }
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: plus-ta.has-hover ? Theme.surface-hi : transparent;
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.plus;
                    fill: transparent;
                    stroke: plus-ta.has-hover ? Theme.text : Theme.muted;
                    stroke-width: 2px;
                }
                plus-ta := TouchArea { mouse-cursor: pointer; clicked => { root.new-playlist(); } }
            }
        }
        VerticalLayout {
            spacing: 2px;
            for p in root.playlists: Rectangle {
                height: 30px;
                border-radius: 6px;
                background: p.id == root.selected-playlist-id ? Theme.surface-hi : (pl-ta.has-hover ? Theme.surface-hi.with-alpha(0.5) : transparent);
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text { text: p.name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: p.subtitle; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
                }
                pl-ta := TouchArea { clicked => { root.select-playlist(p.id); } }
            }
        }
        Text { text: "ARTISTS"; color: Theme.faint; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; }
        artist-list := ListView {
            for artist in root.artists: Rectangle {
                height: 52px;
                border-radius: 8px;
                background: artist.id == root.selected-id ? Theme.surface-hi : (ta.has-hover ? Theme.surface-hi.with-alpha(0.5) : transparent);
                HorizontalLayout {
                    padding: 6px;
                    spacing: 10px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        clip: true;
                        background: Theme.surface-hi;
                        Image { width: 40px; height: 40px; source: artist.image; image-fit: cover; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: artist.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: artist.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
                ta := TouchArea { clicked => { root.select(artist.id); } }
            }
        }
        Text { text: root.status; color: Theme.faint; font-size: 11px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.account; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text {
                text: "Settings";
                color: root.settings-open || settings-ta.has-hover ? Theme.text : Theme.faint;
                font-size: 12px;
                vertical-alignment: center;
                settings-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-settings(); } }
            }
            Text {
                text: "Sign out";
                color: out-ta.has-hover ? Theme.text : Theme.faint;
                font-size: 12px;
                vertical-alignment: center;
                out-ta := TouchArea { mouse-cursor: pointer; clicked => { root.sign-out(); } }
            }
        }
    }
}

component AlbumGrid inherits Rectangle {
    in property <[AlbumItem]> albums;
    in property <length> cell: 180px;
    callback select(string);
    property <int> columns: max(1, floor(self.width / (cell + 20px)));
    min-height: ceil(albums.length / columns) * (cell + 64px);
    for album[i] in albums: Rectangle {
        x: mod(i, root.columns) * (root.cell + 20px);
        y: floor(i / root.columns) * (root.cell + 64px);
        width: root.cell;
        height: root.cell + 54px;
        VerticalLayout {
            alignment: start;
            spacing: 4px;
            Cover {
                source: album.cover;
                size: root.cell;
                drop-shadow-blur: ta.has-hover ? 24px : 12px;
                drop-shadow-color: #00000080;
                animate drop-shadow-blur { duration: 150ms; }
            }
            Text { text: album.title; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
            Text { text: album.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
        ta := TouchArea { clicked => { root.select(album.id); } }
    }
}

component ArtistPage inherits Rectangle {
    in property <ArtistView> artist;
    in property <[AlbumItem]> albums;
    in property <[CreditItem]> members;
    callback select-album(string);
    callback select-artist(string);
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 28px;
            spacing: 24px;
            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                Rectangle {
                    width: 168px;
                    height: 168px;
                    border-radius: 84px;
                    clip: true;
                    background: Theme.surface-hi;
                    Image { width: 168px; height: 168px; source: artist.image; image-fit: cover; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text { text: "ARTIST"; color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; }
                    Text { text: artist.name; color: Theme.text; font-size: 44px; font-weight: 900; letter-spacing: -1px; }
                    if artist.meta != "": Text { text: artist.meta; color: Theme.text; font-size: 13px; }
                    Text { text: artist.stats; color: Theme.muted; font-size: 13px; }
                    Text { text: artist.genres; color: Theme.faint; font-size: 12px; }
                }
            }
            if artist.biography != "": Text {
                text: artist.biography;
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
                max-width: 760px;
            }
            if root.members.length > 0: VerticalLayout {
                max-width: 760px;
                Text { text: "Members"; color: Theme.text; font-size: 18px; font-weight: 700; }
                CreditList {
                    items: root.members;
                    select-artist(id) => { root.select-artist(id); }
                }
            }
            Text { text: "Discography"; color: Theme.text; font-size: 18px; font-weight: 700; }
            AlbumGrid {
                albums: root.albums;
                select(id) => { root.select-album(id); }
            }
        }
    }
}

component AlbumPage inherits Rectangle {
    in property <AlbumView> album;
    in property <[TrackItem]> tracks;
    in property <[PlaylistItem]> playlists;
    callback play(int);
    callback back();
    callback album-action(string, string);
    callback track-action(int, string, string);
    VerticalLayout {
        padding: 28px;
        spacing: 20px;
        HorizontalLayout {
            spacing: 24px;
            alignment: start;
            Cover {
                source: album.cover;
                size: 200px;
                drop-shadow-blur: 30px;
                drop-shadow-color: #000000a0;
            }
            VerticalLayout {
                alignment: end;
                spacing: 6px;
                Text {
                    text: "‹ Back to artist";
                    color: back-ta.has-hover ? Theme.text : Theme.muted;
                    font-size: 12px;
                    back-ta := TouchArea { clicked => { root.back(); } }
                }
                Text { text: "ALBUM"; color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; }
                Text { text: album.title; color: Theme.text; font-size: 36px; font-weight: 900; letter-spacing: -0.8px; wrap: word-wrap; }
                Text { text: album.artist; color: Theme.text; font-size: 15px; font-weight: 600; }
                Text { text: album.meta; color: Theme.muted; font-size: 12px; }
                Text { text: album.genres; color: Theme.faint; font-size: 12px; }
                HorizontalLayout {
                    alignment: start;
                    padding-top: 8px;
                    spacing: 12px;
                    IconButton { glyph: "▶"; primary: true; size: 48px; clicked => { root.play(0); } }
                    IconButton { glyph: "⋯"; size: 48px; clicked => { album-menu.show(); } }
                }
            }
        }
        ListView {
            for track[i] in root.tracks: TrackRow {
                track: track;
                playlists: root.playlists;
                play => { root.play(i); }
                action(kind, id) => { root.track-action(i, kind, id); }
            }
        }
    }
    album-menu := ActionMenu {
        x: 290px;
        y: 250px;
        playlists: root.playlists;
        action(kind, id) => { root.album-action(kind, id); }
    }
}

component AlbumsPage inherits Rectangle {
    in property <string> summary;
    in property <string> sort;
    in property <[AlbumRow]> rows;
    /// Bumped to scroll back to the top (after re-sorting).
    in property <int> reset;
    callback select(string);
    callback sort-by(string);
    callback columns-changed(int);
    callback visible-rows(int, int);
    property <length> cell: 168px;
    property <length> gap: 20px;
    property <length> row-height: root.cell + 70px;
    property <int> columns: max(1, floor((list.visible-width - 8px + root.gap) / (root.cell + root.gap)));
    function report() {
        root.visible-rows(floor(-list.content-y / root.row-height), floor((-list.content-y + list.visible-height) / root.row-height));
    }
    init => {
        root.columns-changed(root.columns);
        root.report();
    }
    changed columns => {
        root.columns-changed(root.columns);
        root.report();
    }
    changed reset => { list.content-y = 0; }
    VerticalLayout {
        padding: 28px;
        padding-bottom: 0;
        spacing: 16px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                Text { text: "Albums"; color: Theme.text; font-size: 28px; font-weight: 800; }
                Text { text: root.summary; color: Theme.muted; font-size: 13px; }
            }
            Rectangle { horizontal-stretch: 1; }
            for option in [{ key: "artist", label: "Artist" }, { key: "title", label: "Title" }, { key: "year", label: "Year" }, { key: "added", label: "Recently added" }]: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 28px;
                    width: sort-label.preferred-width + 24px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: option.key == root.sort ? Theme.text : (sort-ta.has-hover ? Theme.muted : Theme.faint);
                    background: option.key == root.sort ? Theme.surface-hi : transparent;
                    sort-label := Text { text: option.label; color: option.key == root.sort ? Theme.text : Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    sort-ta := TouchArea { mouse-cursor: pointer; clicked => { root.sort-by(option.key); } }
                }
            }
        }
        list := ListView {
            vertical-stretch: 1;
            changed content-y => { root.report(); }
            changed visible-height => { root.report(); }
            for row in root.rows: HorizontalLayout {
                height: root.row-height;
                spacing: root.gap;
                alignment: start;
                for album in row.items: Rectangle {
                    width: root.cell;
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        Cover {
                            source: album.cover;
                            size: root.cell;
                            drop-shadow-blur: ta.has-hover ? 24px : 12px;
                            drop-shadow-color: #00000080;
                            animate drop-shadow-blur { duration: 150ms; }
                        }
                        Text { text: album.title; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: album.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { root.select(album.id); } }
                }
            }
        }
    }
}

component HistoryPage inherits Rectangle {
    in property <bool> loaded;
    in property <string> summary;
    in property <[ArtistItem]> artists;
    in property <[TrackItem]> top;
    in property <[TrackItem]> recent;
    in property <[PlaylistItem]> playlists;
    callback select-artist(string);
    callback play(string, int);
    callback track-action(string, int, string, string);
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 28px;
            spacing: 18px;
            VerticalLayout {
                spacing: 6px;
                Text { text: "History"; color: Theme.text; font-size: 28px; font-weight: 800; }
                if root.summary != "": Text { text: root.summary; color: Theme.muted; font-size: 13px; }
            }
            if root.loaded && root.recent.length == 0: Text {
                text: "Nothing yet. Tracks you listen to (half of them, or 4 minutes) show up here.";
                color: Theme.faint;
                font-size: 13px;
                wrap: word-wrap;
            }
            if root.artists.length > 0: Text { text: "Top artists · last 30 days"; color: Theme.text; font-size: 18px; font-weight: 700; }
            if root.artists.length > 0: HorizontalLayout {
                alignment: start;
                spacing: 20px;
                for artist in root.artists: VerticalLayout {
                    width: 110px;
                    spacing: 4px;
                    Rectangle {
                        width: 110px;
                        height: 110px;
                        border-radius: 55px;
                        clip: true;
                        background: Theme.surface-hi;
                        Image { width: 110px; height: 110px; source: artist.image; image-fit: cover; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.select-artist(artist.id); } }
                    }
                    Text { text: artist.name; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                    Text { text: artist.subtitle; color: Theme.muted; font-size: 11px; horizontal-alignment: center; }
                }
            }
            if root.top.length > 0: Text { text: "Most played · last 30 days"; color: Theme.text; font-size: 18px; font-weight: 700; }
            for track[i] in root.top: TrackRow {
                track: track;
                playlists: root.playlists;
                play => { root.play("history-top", i); }
                action(kind, id) => { root.track-action("history-top", i, kind, id); }
            }
            if root.recent.length > 0: Text { text: "Recently played"; color: Theme.text; font-size: 18px; font-weight: 700; }
            for track[i] in root.recent: TrackRow {
                track: track;
                playlists: root.playlists;
                play => { root.play("history-recent", i); }
                action(kind, id) => { root.track-action("history-recent", i, kind, id); }
            }
        }
    }
}

component SearchPage inherits Rectangle {
    in property <string> query;
    in property <[ArtistItem]> artists;
    in property <[AlbumItem]> albums;
    in property <[TrackItem]> tracks;
    in property <[PlaylistItem]> playlists;
    callback select-artist(string);
    callback select-album(string);
    callback play(int);
    callback track-action(int, string, string);
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 28px;
            spacing: 18px;
            Text { text: "Results for “" + root.query + "”"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if artists.length + albums.length + tracks.length == 0: Text {
                text: "Nothing matches. Every word must appear in a title, artist or album name.";
                color: Theme.faint;
                font-size: 13px;
            }
            if artists.length > 0: Text { text: "Artists"; color: Theme.text; font-size: 18px; font-weight: 700; }
            if artists.length > 0: HorizontalLayout {
                alignment: start;
                spacing: 20px;
                for artist in root.artists: VerticalLayout {
                    width: 120px;
                    spacing: 6px;
                    Rectangle {
                        width: 120px;
                        height: 120px;
                        border-radius: 60px;
                        clip: true;
                        background: Theme.surface-hi;
                        Image { width: 120px; height: 120px; source: artist.image; image-fit: cover; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.select-artist(artist.id); } }
                    }
                    Text { text: artist.name; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                }
            }
            if albums.length > 0: Text { text: "Albums"; color: Theme.text; font-size: 18px; font-weight: 700; }
            if albums.length > 0: AlbumGrid {
                albums: root.albums;
                select(id) => { root.select-album(id); }
            }
            if tracks.length > 0: Text { text: "Tracks"; color: Theme.text; font-size: 18px; font-weight: 700; }
            for track[i] in root.tracks: TrackRow {
                track: track;
                playlists: root.playlists;
                play => { root.play(i); }
                action(kind, id) => { root.track-action(i, kind, id); }
            }
        }
    }
}

component PlaylistPage inherits Rectangle {
    in property <PlaylistView> playlist;
    in property <[TrackItem]> tracks;
    in property <[PlaylistItem]> playlists;
    callback play(int);
    callback shuffle-play();
    callback rename(string);
    callback delete();
    callback track-action(int, string, string);
    property <bool> confirm-delete;
    VerticalLayout {
        padding: 28px;
        spacing: 20px;
        HorizontalLayout {
            spacing: 24px;
            alignment: start;
            Cover {
                source: playlist.cover;
                size: 200px;
                drop-shadow-blur: 30px;
                drop-shadow-color: #000000a0;
            }
            VerticalLayout {
                alignment: end;
                spacing: 6px;
                Text { text: "PLAYLIST"; color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; }
                LineEdit {
                    text: playlist.name;
                    font-size: 24px;
                    min-width: 360px;
                    accepted(text) => { root.rename(text); }
                }
                Text { text: playlist.meta + "  ·  edit the name and press Enter to rename"; color: Theme.muted; font-size: 12px; }
                HorizontalLayout {
                    alignment: start;
                    padding-top: 8px;
                    spacing: 12px;
                    IconButton { glyph: "▶"; primary: true; size: 48px; clicked => { root.play(0); } }
                    VerticalLayout {
                        alignment: center;
                        ToggleIcon { commands: Icons.shuffle; clicked => { root.shuffle-play(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: delete-label.preferred-width + 24px;
                            height: 32px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: root.confirm-delete ? #e5484d : (delete-ta.has-hover ? Theme.text : Theme.faint);
                            delete-label := Text {
                                text: root.confirm-delete ? "Click again to delete" : "Delete";
                                color: root.confirm-delete ? #e5484d : Theme.muted;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            delete-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.confirm-delete { root.delete(); }
                                    root.confirm-delete = !root.confirm-delete;
                                }
                            }
                        }
                    }
                }
            }
        }
        if tracks.length == 0: Text {
            text: "Empty. Add tracks from any album or search result with the ⋯ menu.";
            color: Theme.faint;
            font-size: 13px;
        }
        ListView {
            for track[i] in root.tracks: TrackRow {
                track: track;
                playlists: root.playlists;
                removable: true;
                movable: true;
                remove-label: "Remove from this playlist";
                play => { root.play(i); }
                action(kind, id) => { root.track-action(i, kind, id); }
            }
        }
    }
}

component QueuePage inherits Rectangle {
    in property <string> origin;
    in property <[TrackItem]> now;
    in property <[TrackItem]> next;
    in property <[PlaylistItem]> playlists;
    callback jump(int);
    callback clear();
    callback track-action(int, string, string);
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 28px;
            spacing: 14px;
            HorizontalLayout {
                Text { text: "Queue"; color: Theme.text; font-size: 28px; font-weight: 800; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: clear-label.preferred-width + 24px;
                        height: 30px;
                        border-radius: 15px;
                        border-width: 1px;
                        border-color: clear-ta.has-hover ? Theme.text : Theme.faint;
                        clear-label := Text { text: "Clear"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        clear-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clear(); } }
                    }
                }
            }
            if origin != "": Text { text: "Playing from " + root.origin; color: Theme.muted; font-size: 13px; }
            if now.length == 0 && next.length == 0: Text {
                text: "Nothing queued. Use the ⋯ menu on any track or album to add music.";
                color: Theme.faint;
                font-size: 13px;
            }
            if now.length > 0: Text { text: "NOW PLAYING"; color: Theme.faint; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; }
            for track in root.now: TrackRow {
                track: track;
                playlists: root.playlists;
                action(kind, id) => { root.track-action(-1, kind, id); }
            }
            if next.length > 0: Text { text: "NEXT UP"; color: Theme.faint; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; }
            for track[i] in root.next: TrackRow {
                track: track;
                playlists: root.playlists;
                removable: true;
                remove-label: "Remove from queue";
                play => { root.jump(i); }
                action(kind, id) => { root.track-action(i, kind, id); }
            }
        }
    }
}

component NowPlayingPanel inherits Rectangle {
    in property <NowPlayingView> np;
    in property <[AlbumItem]> more-from;
    in property <[CreditItem]> credits;
    in property <[CreditItem]> members;
    callback select-album(string);
    callback select-artist(string);
    background: Theme.surface;
    clip: true;
    // Blurred, darkened cover fills the panel; the accent colour tints it.
    Image {
        width: parent.width;
        height: parent.height;
        source: np.backdrop;
        image-fit: cover;
        opacity: 0.55;
    }
    Rectangle {
        background: @linear-gradient(180deg, np.accent.with-alpha(0.25) 0%, Theme.surface.with-alpha(0.85) 45%, Theme.surface 100%);
    }
    if !np.active: Text {
        text: "Nothing playing";
        color: Theme.faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if np.active: ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 22px;
            spacing: 14px;
            Text { text: "NOW PLAYING"; color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; }
            Cover {
                source: np.cover;
                size: root.width - 44px;
                drop-shadow-blur: 40px;
                drop-shadow-color: np.accent.with-alpha(0.45);
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: np.title; color: Theme.text; font-size: 22px; font-weight: 800; wrap: word-wrap; }
                Text { text: np.artist; color: Theme.text; font-size: 15px; font-weight: 600; }
                Text { text: np.album + (np.year == "" ? "" : "  ·  " + np.year); color: Theme.muted; font-size: 13px; }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Chip { text: np.format; accent: np.accent; }
                if np.quality != "": Chip { text: np.quality; accent: np.accent; }
            }
            if np.genres != "": Text { text: np.genres; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Theme.surface-hi; }
            Text { text: "Credits"; color: Theme.text; font-size: 15px; font-weight: 700; }
            if credits.length == 0: Text {
                text: np.loading-details ? "Looking up musicians…" : "No credits found for this track.";
                color: Theme.faint;
                font-size: 12px;
            }
            CreditList {
                items: root.credits;
                accent: np.accent;
                select-artist(id) => { root.select-artist(id); }
            }
            Rectangle { height: 1px; background: Theme.surface-hi; }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "About " + np.artist;
                    color: about-ta.has-hover ? np.accent.brighter(0.4) : Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    about-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select-artist(np.artist-id); }
                    }
                }
                if np.artist-meta != "": Text { text: np.artist-meta; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
            }
            Text {
                text: np.biography != "" ? np.biography : np.loading-details ? "Fetching biography…" : "No biography available.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            if members.length > 0: CreditList {
                items: root.members;
                accent: np.accent;
                select-artist(id) => { root.select-artist(id); }
            }
            if more-from.length > 0: Text { text: "More from " + np.artist; color: Theme.text; font-size: 15px; font-weight: 700; }
            if more-from.length > 0: AlbumGrid {
                albums: root.more-from;
                cell: (root.width - 44px - 20px) / 2;
                select(id) => { root.select-album(id); }
            }
        }
    }
}

component LyricsPage inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <LyricsState> state;
    in property <[string]> lines;
    /// The synced line being sung, or -1.
    in property <int> current: -1;
    in property <string> source;
    callback seek-line(int);
    property <length> row-height: 60px;
    // Keep the sung line a third of the way down, like a teleprompter.
    changed current => {
        if root.current >= 0 {
            list.content-y = min(0px, max(list.visible-height - list.content-height, list.visible-height / 3 - root.current * root.row-height));
        }
    }
    VerticalLayout {
        padding: 28px;
        padding-bottom: 12px;
        spacing: 6px;
        Text { text: root.title == "" ? "Lyrics" : root.title; color: Theme.text; font-size: 28px; font-weight: 800; overflow: elide; }
        Text { text: root.artist; color: Theme.muted; font-size: 14px; overflow: elide; }
        if root.state != LyricsState.plain && root.state != LyricsState.synced: Text {
            vertical-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: Theme.faint;
            font-size: 18px;
            text: root.state == LyricsState.loading ? "Looking for lyrics…"
                : root.state == LyricsState.instrumental ? "Instrumental"
                : root.title == "" ? "Nothing is playing" : "No lyrics found for this track";
        }
        list := ListView {
            visible: root.state == LyricsState.plain || root.state == LyricsState.synced;
            vertical-stretch: 1;
            for line[i] in root.lines: Rectangle {
                height: root.row-height;
                Text {
                    width: parent.width;
                    text: line;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: 22px;
                    font-weight: 700;
                    color: root.state != LyricsState.synced || i == root.current ? Theme.text
                        : line-ta.has-hover ? Theme.muted
                        : i < root.current ? Theme.muted.with-alpha(0.7) : Theme.faint;
                    animate color { duration: 200ms; }
                }
                line-ta := TouchArea {
                    enabled: root.state == LyricsState.synced;
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => { root.seek-line(i); }
                }
            }
        }
        if root.source != "": Text { text: root.source; color: Theme.faint; font-size: 11px; }
    }
}

component TransportBar inherits Rectangle {
    in property <NowPlayingView> np;
    in property <bool> playing;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text;
    in property <string> duration-text;
    in-out property <float> volume;
    in property <string> stream-info;
    in property <string> quality-mode;
    in property <string> replaygain-mode;
    callback cycle-replaygain();
    in property <bool> shuffle;
    in property <RepeatMode> repeat;
    // Same green as the playing-track marker, so "active" reads the same everywhere.
    in property <color> accent: #1ed760;
    in property <bool> queue-open;
    in property <bool> lyrics-open;
    callback show-lyrics();
    callback toggle();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback show-queue();
    callback next();
    callback prev();
    callback seek(float);
    callback volume-changed(float);
    callback cycle-quality-mode();
    changed position => {
        if !seek-bar.dragging {
            seek-bar.value = root.position;
        }
    }
    height: 84px;
    background: Theme.bg;
    Rectangle { y: 0; height: 1px; background: Theme.surface-hi; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        HorizontalLayout {
            width: 280px;
            spacing: 12px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Cover { source: np.cover; size: 56px; border-radius: 6px; }
            }
            VerticalLayout {
                alignment: center;
                Text { text: np.title; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                Text { text: np.artist; color: Theme.muted; font-size: 11px; overflow: elide; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                ToggleIcon {
                    commands: Icons.shuffle;
                    active: root.shuffle;
                    accent: root.accent;
                    clicked => { root.toggle-shuffle(); }
                }
                IconButton { glyph: "⏮"; clicked => { root.prev(); } }
                IconButton { glyph: root.playing ? "⏸" : "▶"; primary: true; size: 40px; clicked => { root.toggle(); } }
                IconButton { glyph: "⏭"; clicked => { root.next(); } }
                ToggleIcon {
                    commands: root.repeat == RepeatMode.one ? Icons.repeat-one : Icons.repeat;
                    active: root.repeat != RepeatMode.off;
                    accent: root.accent;
                    clicked => { root.cycle-repeat(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.position-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                seek-bar := Slider {
                    // Dragging assigns `value`, which would break a `value: root.position`
                    // binding for good: the position is pushed in below instead.
                    property <bool> dragging;
                    minimum: 0;
                    maximum: max(1, root.duration);
                    changed(v) => { self.dragging = true; }
                    released(v) => {
                        self.dragging = false;
                        root.seek(v);
                    }
                }
                Text { text: root.duration-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            width: 320px;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "🔊"; color: Theme.muted; vertical-alignment: center; }
                Slider {
                    minimum: 0;
                    maximum: 1;
                    value <=> root.volume;
                    changed(v) => { root.volume-changed(v); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                ToggleIcon {
                    commands: Icons.lyrics;
                    active: root.lyrics-open;
                    accent: root.accent;
                    clicked => { root.show-lyrics(); }
                }
                ToggleIcon {
                    commands: Icons.queue;
                    active: root.queue-open;
                    accent: root.accent;
                    clicked => { root.show-queue(); }
                }
                Rectangle {
                    width: rg-label.preferred-width + 14px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: rg-ta.has-hover ? Theme.text : Theme.faint;
                    rg-label := Text {
                        text: root.replaygain-mode;
                        color: Theme.muted;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    rg-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cycle-replaygain(); }
                    }
                }
                Rectangle {
                    width: mode-label.preferred-width + 14px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: mode-ta.has-hover ? Theme.text : Theme.faint;
                    mode-label := Text {
                        text: root.quality-mode;
                        color: Theme.muted;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    mode-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cycle-quality-mode(); }
                    }
                }
            }
            // Its own line: quality, measured speed and ReplayGain don't fit beside the chips.
            Text {
                text: root.stream-info;
                color: Theme.faint;
                font-size: 11px;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text { text: root.label; color: Theme.faint; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
    @children
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> busy;
    callback clicked;
    height: 40px;
    border-radius: 20px;
    background: root.busy ? Theme.surface-hi : (ta.has-hover ? #ffffff : #e8e9ec);
    Text {
        text: root.busy ? "Please wait…" : root.text;
        color: root.busy ? Theme.muted : Theme.bg;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LoginScreen inherits Rectangle {
    in property <LoginState> state;
    in-out property <string> server;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> new-password;
    in-out property <string> confirm-password;
    in-out property <string> full-name;
    callback submit();
    callback check-server();
    callback change-password();
    callback onboard();
    callback skip-onboarding();
    background: Theme.bg;
    // Swallow clicks so nothing behind the screen reacts.
    TouchArea { }
    // Centred card, sized by its contents (fields come and go with the step and errors).
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 400px;
                border-radius: 14px;
                background: Theme.surface;
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000090;
                // A layout (unlike the Rectangle itself) sizes to whichever step is shown.
                VerticalLayout {
                    if !root.state.changing-password && !root.state.onboarding: VerticalLayout {
                        padding: 32px;
                        spacing: 14px;
                        Text { text: "HyperPlayer"; color: Theme.text; font-size: 26px; font-weight: 800; letter-spacing: -0.5px; }
                        Text {
                            text: root.state.default-admin
                                ? "First time on this server? Sign in as admin with the password “hyperplayer”, then choose your own."
                                : "Sign in to your server.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Field {
                            label: "SERVER";
                            LineEdit {
                                text <=> root.server;
                                placeholder-text: "http://127.0.0.1:4533";
                                accepted => { root.check-server(); }
                            }
                        }
                        Field {
                            label: "USERNAME";
                            LineEdit { text <=> root.username; placeholder-text: "Username"; }
                        }
                        Field {
                            label: "PASSWORD";
                            LineEdit {
                                text <=> root.password;
                                input-type: InputType.password;
                                placeholder-text: "Password";
                                accepted => { root.submit(); }
                            }
                        }
                        if root.state.error != "": Text { text: root.state.error; color: #e5484d; font-size: 12px; wrap: word-wrap; }
                        PrimaryButton { text: "Sign in"; busy: root.state.busy; clicked => { root.submit(); } }
                    }
                    if root.state.changing-password: VerticalLayout {
                        padding: 32px;
                        spacing: 14px;
                        Text { text: "Choose your password"; color: Theme.text; font-size: 22px; font-weight: 800; }
                        Text {
                            text: "You signed in with the default password. Pick your own to continue; the default stops working once you do.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.state.need-current: Field {
                            label: "CURRENT PASSWORD";
                            LineEdit { text <=> root.password; input-type: InputType.password; }
                        }
                        Field {
                            label: "NEW PASSWORD (AT LEAST 8 CHARACTERS)";
                            LineEdit { text <=> root.new-password; input-type: InputType.password; }
                        }
                        Field {
                            label: "REPEAT IT";
                            LineEdit {
                                text <=> root.confirm-password;
                                input-type: InputType.password;
                                accepted => { root.change-password(); }
                            }
                        }
                        if root.state.error != "": Text { text: root.state.error; color: #e5484d; font-size: 12px; wrap: word-wrap; }
                        PrimaryButton { text: "Save and continue"; busy: root.state.busy; clicked => { root.change-password(); } }
                    }
                    if root.state.onboarding: VerticalLayout {
                        padding: 32px;
                        spacing: 14px;
                        Text { text: "Who's listening?"; color: Theme.text; font-size: 22px; font-weight: 800; }
                        Text {
                            text: "Create your own account for everyday listening, with your playlists and preferences. The admin account stays for managing the server.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Field {
                            label: "FULL NAME (OPTIONAL)";
                            LineEdit { text <=> root.full-name; placeholder-text: "Your name"; }
                        }
                        Field {
                            label: "USERNAME";
                            LineEdit { text <=> root.username; placeholder-text: "Username"; }
                        }
                        Field {
                            label: "PASSWORD (AT LEAST 8 CHARACTERS)";
                            LineEdit { text <=> root.new-password; input-type: InputType.password; }
                        }
                        Field {
                            label: "REPEAT IT";
                            LineEdit {
                                text <=> root.confirm-password;
                                input-type: InputType.password;
                                accepted => { root.onboard(); }
                            }
                        }
                        if root.state.error != "": Text { text: root.state.error; color: #e5484d; font-size: 12px; wrap: word-wrap; }
                        PrimaryButton { text: "Create my account"; busy: root.state.busy; clicked => { root.onboard(); } }
                        Text {
                            text: "Skip: keep using the admin account";
                            color: skip-ta.has-hover ? Theme.text : Theme.faint;
                            font-size: 12px;
                            horizontal-alignment: center;
                            skip-ta := TouchArea { mouse-cursor: pointer; clicked => { root.skip-onboarding(); } }
                        }
                    }
                }
            }
        }
    }
}

component ShortcutHelp inherits Rectangle {
    callback close();
    background: #000000a0;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: 420px;
        height: rows.preferred-height + 48px;
        border-radius: 12px;
        background: Theme.surface-hi;
        drop-shadow-blur: 30px;
        drop-shadow-color: #000000c0;
        rows := VerticalLayout {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            spacing: 8px;
            Text { text: "Keyboard shortcuts"; color: Theme.text; font-size: 18px; font-weight: 800; }
            for row in [
                { key: "Space", what: "Play / pause" },
                { key: "← / →", what: "Seek back / forward 10 s" },
                { key: "Ctrl+← / Ctrl+→", what: "Previous / next track" },
                { key: "↑ / ↓", what: "Volume up / down" },
                { key: "M", what: "Mute" },
                { key: "S / R", what: "Shuffle / repeat" },
                { key: "Q", what: "Queue" },
                { key: "L", what: "Lyrics" },
                { key: "H", what: "History" },
                { key: "A", what: "Albums" },
                { key: ",", what: "Settings" },
                { key: "/  or  Ctrl+F", what: "Search" },
                { key: "Esc", what: "Leave search / close" },
                { key: "?", what: "This help" },
            ]: HorizontalLayout {
                Text { width: 150px; text: row.key; color: Theme.text; font-size: 13px; font-weight: 700; }
                Text { text: row.what; color: Theme.muted; font-size: 13px; }
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    in property <bool> lb-connected;
    in property <string> lb-username;
    in property <string> lb-status;
    in property <bool> lb-failing;
    in property <bool> lb-busy;
    in property <string> lb-error;
    in-out property <string> lb-token;
    callback lb-connect(string);
    callback lb-disconnect();
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 28px;
            spacing: 18px;
            Text { text: "Settings"; color: Theme.text; font-size: 28px; font-weight: 800; }
            Text { text: "Scrobbling"; color: Theme.text; font-size: 18px; font-weight: 700; }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                max-width: 640px;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "ListenBrainz"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        if root.lb-connected: VerticalLayout {
                            alignment: center;
                            Chip { text: "Connected as " + root.lb-username; accent: #1ed760; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: "Sends what you listen to to your ListenBrainz profile, for a public listening history, statistics and recommendations. Listens are sent from the moment you connect; earlier history stays here.";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.lb-connected: Text {
                        text: root.lb-status;
                        color: root.lb-failing ? #ff8a80 : Theme.muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    // Shown to connect, and to replace a token ListenBrainz no longer accepts.
                    if !root.lb-connected || root.lb-failing: Field {
                        label: "USER TOKEN";
                        token := LineEdit {
                            text <=> root.lb-token;
                            input-type: InputType.password;
                            placeholder-text: "Copy it from listenbrainz.org/settings";
                            accepted(t) => { root.lb-connect(t); }
                        }
                    }
                    if root.lb-error != "": Text { text: root.lb-error; color: #ff8a80; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 12px;
                        if !root.lb-connected || root.lb-failing: PrimaryButton {
                            width: 160px;
                            text: root.lb-connected ? "Reconnect" : "Connect";
                            busy: root.lb-busy;
                            clicked => { root.lb-connect(root.lb-token); }
                        }
                        if root.lb-connected: Rectangle {
                            height: 40px;
                            width: disconnect-label.preferred-width + 36px;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: disconnect-ta.has-hover ? Theme.text : Theme.faint;
                            disconnect-label := Text { text: "Disconnect"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                            disconnect-ta := TouchArea { mouse-cursor: pointer; clicked => { root.lb-disconnect(); } }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: np.active ? np.title + " — " + np.artist : "HyperPlayer";
    preferred-width: 1400px;
    preferred-height: 880px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: "Inter";

    in property <[ArtistItem]> artists;
    in property <string> selected-artist-id;
    in property <string> status;
    in property <Page> page: Page.welcome;
    in property <ArtistView> artist;
    in property <[AlbumItem]> artist-albums;
    in property <AlbumView> album;
    in property <[TrackItem]> album-tracks;
    in property <string> search-query;
    in property <[ArtistItem]> search-artists;
    in property <[AlbumItem]> search-albums;
    in property <[TrackItem]> search-tracks;
    in property <[PlaylistItem]> playlists;
    in property <string> selected-playlist-id;
    in property <PlaylistView> playlist;
    in property <[TrackItem]> playlist-tracks;
    in property <string> queue-origin;
    in property <[TrackItem]> queue-now;
    in property <[TrackItem]> queue-next;
    in property <NowPlayingView> np;
    in property <[AlbumItem]> more-from;
    in property <[CreditItem]> credits;
    in property <[CreditItem]> np-members;
    in property <[CreditItem]> artist-members;
    in property <bool> playing;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <float> volume: 0.8;
    in property <string> stream-info;
    in property <string> quality-mode: "AUTO";
    in property <string> replaygain-mode: "RG AUTO";
    callback cycle-replaygain();
    in property <bool> shuffle;
    in property <RepeatMode> repeat;

    callback select-artist(string);
    callback select-album(string);
    callback play-track(int);
    callback play-search-track(int);
    callback show-history();
    callback show-albums();
    callback show-settings();
    callback lb-connect(string);
    callback lb-disconnect();
    in property <bool> lb-connected;
    in property <string> lb-username;
    in property <string> lb-status;
    in property <bool> lb-failing;
    in property <bool> lb-busy;
    in property <string> lb-error;
    in-out property <string> lb-token;
    callback albums-sort-by(string);
    callback albums-columns(int);
    callback albums-visible(int, int);
    in property <string> albums-summary;
    in property <string> albums-sort: "artist";
    in property <[AlbumRow]> albums-rows;
    property <int> albums-reset;
    public function albums-scroll-to-top() { root.albums-reset += 1; }
    callback play-history-track(string, int);
    in property <bool> history-loaded;
    in property <string> history-summary;
    in property <[ArtistItem]> history-artists;
    in property <[TrackItem]> history-top;
    in property <[TrackItem]> history-recent;
    callback search-changed(string);
    callback search-accepted(string);
    public function reveal-artist(index: int) { sidebar.reveal-artist(index); }
    callback select-playlist(string);
    callback new-playlist();
    callback play-playlist(int);
    callback shuffle-playlist();
    callback rename-playlist(string);
    callback delete-playlist();
    callback album-action(string, string);
    /// (list, index, action, playlist id); list is "album", "search", "playlist" or "queue".
    callback track-action(string, int, string, string);
    callback show-queue();
    callback show-lyrics();
    callback seek-lyric-line(int);
    in property <LyricsState> lyrics-state: LyricsState.none;
    in property <[string]> lyrics-lines;
    in property <int> lyrics-current: -1;
    in property <string> lyrics-source;
    callback jump-in-queue(int);
    callback clear-queue();
    /// Keyboard actions handled in Rust: "seek-back", "seek-forward", "toggle-mute".
    callback shortcut(string);
    in property <bool> signed-in;
    in property <LoginState> login;
    in-out property <string> login-server;
    in-out property <string> login-username;
    in-out property <string> login-password;
    in-out property <string> login-new-password;
    in-out property <string> login-confirm-password;
    in-out property <string> login-full-name;
    in property <string> account;
    callback login-submit();
    callback login-check-server();
    callback login-change-password();
    callback login-onboard();
    callback login-skip-onboarding();
    callback sign-out();
    property <bool> show-help;
    init => { keys.focus(); }
    callback back-to-artist();
    callback toggle();
    callback next();
    callback prev();
    callback seek(float);
    callback volume-changed(float);
    callback cycle-quality-mode();
    callback toggle-shuffle();
    callback cycle-repeat();

    keys := FocusScope {
    key-pressed(event) => {
        if event.text == Key.Escape {
            if root.show-help { root.show-help = false; }
            else if sidebar.clear-search() { }
            else if root.page == Page.queue { root.show-queue(); }
            else if root.page == Page.lyrics { root.show-lyrics(); }
            else if root.page == Page.history { root.show-history(); }
            else if root.page == Page.albums { root.show-albums(); }
            else if root.page == Page.settings { root.show-settings(); }
            keys.focus();
            return accept;
        }
        // Everything else is ignored while modifier combos other than Ctrl are held.
        if event.modifiers.alt || event.modifiers.meta { return reject; }
        if event.modifiers.control {
            if event.text == Key.LeftArrow { root.prev(); return accept; }
            if event.text == Key.RightArrow { root.next(); return accept; }
            if event.text == "f" { sidebar.focus-search(); return accept; }
            return reject;
        }
        if event.text == " " { root.toggle(); return accept; }
        if event.text == Key.LeftArrow { root.shortcut("seek-back"); return accept; }
        if event.text == Key.RightArrow { root.shortcut("seek-forward"); return accept; }
        if event.text == Key.UpArrow {
            root.volume = min(1.0, root.volume + 0.05);
            root.volume-changed(root.volume);
            return accept;
        }
        if event.text == Key.DownArrow {
            root.volume = max(0.0, root.volume - 0.05);
            root.volume-changed(root.volume);
            return accept;
        }
        if event.text == "m" || event.text == "M" { root.shortcut("toggle-mute"); return accept; }
        if event.text == "s" || event.text == "S" { root.toggle-shuffle(); return accept; }
        if event.text == "r" || event.text == "R" { root.cycle-repeat(); return accept; }
        if event.text == "q" || event.text == "Q" { root.show-queue(); return accept; }
        if event.text == "l" || event.text == "L" { root.show-lyrics(); return accept; }
        if event.text == "h" || event.text == "H" { root.show-history(); return accept; }
        if event.text == "a" || event.text == "A" { root.show-albums(); return accept; }
        if event.text == "," { root.show-settings(); return accept; }
        if event.text == "/" { sidebar.focus-search(); return accept; }
        if event.text == "?" { root.show-help = !root.show-help; return accept; }
        return reject;
    }
    VerticalLayout {
        HorizontalLayout {
            sidebar := Sidebar {
                width: 260px;
                artists: root.artists;
                selected-id: root.selected-artist-id;
                status: root.status;
                select(id) => { root.select-artist(id); }
                search-changed(text) => { root.search-changed(text); }
                search-accepted(text) => { root.search-accepted(text); }
                playlists: root.playlists;
                selected-playlist-id: root.page == Page.playlist ? root.selected-playlist-id : "";
                select-playlist(id) => { root.select-playlist(id); }
                new-playlist => { root.new-playlist(); }
                account: root.account;
                sign-out => { root.sign-out(); }
                history-open: root.page == Page.history;
                show-history => { root.show-history(); }
                albums-open: root.page == Page.albums;
                show-albums => { root.show-albums(); }
                settings-open: root.page == Page.settings;
                show-settings => { root.show-settings(); }
            }
            Rectangle {
                horizontal-stretch: 1;
                if root.page == Page.welcome: Text {
                    text: "Pick an artist to start listening";
                    color: Theme.faint;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.page == Page.artist: ArtistPage {
                    artist: root.artist;
                    albums: root.artist-albums;
                    members: root.artist-members;
                    select-album(id) => { root.select-album(id); }
                    select-artist(id) => { root.select-artist(id); }
                }
                if root.page == Page.search: SearchPage {
                    query: root.search-query;
                    artists: root.search-artists;
                    albums: root.search-albums;
                    tracks: root.search-tracks;
                    playlists: root.playlists;
                    select-artist(id) => { root.select-artist(id); }
                    select-album(id) => { root.select-album(id); }
                    play(i) => { root.play-search-track(i); }
                    track-action(i, kind, id) => { root.track-action("search", i, kind, id); }
                }
                if root.page == Page.playlist: PlaylistPage {
                    playlist: root.playlist;
                    tracks: root.playlist-tracks;
                    playlists: root.playlists;
                    play(i) => { root.play-playlist(i); }
                    shuffle-play => { root.shuffle-playlist(); }
                    rename(name) => { root.rename-playlist(name); }
                    delete => { root.delete-playlist(); }
                    track-action(i, kind, id) => { root.track-action("playlist", i, kind, id); }
                }
                if root.page == Page.settings: SettingsPage {
                    lb-connected: root.lb-connected;
                    lb-username: root.lb-username;
                    lb-status: root.lb-status;
                    lb-failing: root.lb-failing;
                    lb-busy: root.lb-busy;
                    lb-error: root.lb-error;
                    lb-token <=> root.lb-token;
                    lb-connect(t) => { root.lb-connect(t); }
                    lb-disconnect => { root.lb-disconnect(); }
                }
                if root.page == Page.albums: AlbumsPage {
                    summary: root.albums-summary;
                    sort: root.albums-sort;
                    rows: root.albums-rows;
                    reset: root.albums-reset;
                    select(id) => { root.select-album(id); }
                    sort-by(key) => { root.albums-sort-by(key); }
                    columns-changed(n) => { root.albums-columns(n); }
                    visible-rows(first, last) => { root.albums-visible(first, last); }
                }
                if root.page == Page.history: HistoryPage {
                    loaded: root.history-loaded;
                    summary: root.history-summary;
                    artists: root.history-artists;
                    top: root.history-top;
                    recent: root.history-recent;
                    playlists: root.playlists;
                    select-artist(id) => { root.select-artist(id); }
                    play(list, i) => { root.play-history-track(list, i); }
                    track-action(list, i, kind, id) => { root.track-action(list, i, kind, id); }
                }
                if root.page == Page.lyrics: LyricsPage {
                    title: root.np.active ? root.np.title : "";
                    artist: root.np.active ? root.np.artist : "";
                    state: root.lyrics-state;
                    lines: root.lyrics-lines;
                    current: root.lyrics-current;
                    source: root.lyrics-source;
                    seek-line(i) => { root.seek-lyric-line(i); }
                }
                if root.page == Page.queue: QueuePage {
                    origin: root.queue-origin;
                    now: root.queue-now;
                    next: root.queue-next;
                    playlists: root.playlists;
                    jump(i) => { root.jump-in-queue(i); }
                    clear => { root.clear-queue(); }
                    track-action(i, kind, id) => { root.track-action("queue", i, kind, id); }
                }
                if root.page == Page.album: AlbumPage {
                    album: root.album;
                    tracks: root.album-tracks;
                    playlists: root.playlists;
                    play(i) => { root.play-track(i); }
                    back => { root.back-to-artist(); }
                    album-action(kind, id) => { root.album-action(kind, id); }
                    track-action(i, kind, id) => { root.track-action("album", i, kind, id); }
                }
            }
            NowPlayingPanel {
                width: 360px;
                np: root.np;
                more-from: root.more-from;
                credits: root.credits;
                members: root.np-members;
                select-album(id) => { root.select-album(id); }
                select-artist(id) => { root.select-artist(id); }
            }
        }
        TransportBar {
            np: root.np;
            playing: root.playing;
            position: root.position;
            duration: root.duration;
            position-text: root.position-text;
            duration-text: root.duration-text;
            volume <=> root.volume;
            toggle => { root.toggle(); }
            next => { root.next(); }
            prev => { root.prev(); }
            seek(v) => { root.seek(v); }
            volume-changed(v) => { root.volume-changed(v); }
            stream-info: root.stream-info;
            quality-mode: root.quality-mode;
            cycle-quality-mode => { root.cycle-quality-mode(); }
            replaygain-mode: root.replaygain-mode;
            cycle-replaygain => { root.cycle-replaygain(); }
            shuffle: root.shuffle;
            repeat: root.repeat;
            toggle-shuffle => { root.toggle-shuffle(); }
            cycle-repeat => { root.cycle-repeat(); }
            queue-open: root.page == Page.queue;
            show-queue => { root.show-queue(); }
            lyrics-open: root.page == Page.lyrics;
            show-lyrics => { root.show-lyrics(); }
        }
    }
    }
    if root.show-help: ShortcutHelp {
        close => { root.show-help = false; keys.focus(); }
    }
    if !root.signed-in: LoginScreen {
        state: root.login;
        server <=> root.login-server;
        username <=> root.login-username;
        password <=> root.login-password;
        new-password <=> root.login-new-password;
        confirm-password <=> root.login-confirm-password;
        submit => { root.login-submit(); }
        check-server => { root.login-check-server(); }
        change-password => { root.login-change-password(); }
        full-name <=> root.login-full-name;
        onboard => { root.login-onboard(); }
        skip-onboarding => { root.login-skip-onboarding(); }
    }
}
